{
  "name": "buildmind-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BuildMind API — authentication, projects, builds, AI providers, Roblox/Studio bridge",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "migrate": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "test": "node --test --test-concurrency=1 dist-tests/tests/*.test.js",
    "test:src": "tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "11.4.1",
    "@fastify/rate-limit": "11.2.2",
    "fastify": "5.12.8",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
