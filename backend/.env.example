# ---------------------------------------------------------------------------
# BuildMind API — example environment. Copy to .env and fill in.
# Never commit .env. Every value below is a placeholder.
# ---------------------------------------------------------------------------

# development | test | production
NODE_ENV=development

PORT=3000
HOST=0.0.0.0

# The frontend origin allowed to make credentialed requests.
# Production must be https:// and is checked at startup.
APP_ORIGIN=http://localhost:8080

# PostgreSQL connection string.
DATABASE_URL=postgres://buildmind:password@localhost:5432/buildmind

# Signs session cookies. At least 32 characters; production requires 64+.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=replace-me-with-a-long-random-string-at-least-32-chars

# Wraps BYOK provider keys at rest (AES-256-GCM). Exactly 32 bytes, base64.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=replace-with-32-byte-base64-key

# --- AI providers ----------------------------------------------------------
# Optional at boot. Without a key, BYOK is the only way a build can run.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GOOGLE_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# BuildMind-managed credentials: used when the user supplies no key of their
# own. Leave blank to require BYOK. Never sent to a browser.
MANAGED_OPENAI_API_KEY=
MANAGED_GOOGLE_API_KEY=

# --- Roblox ---------------------------------------------------------------
# All three must be set together, or none. None means the API reports
# ROBLOX_NOT_CONFIGURED rather than pretending the integration exists.
ROBLOX_CLIENT_ID=
ROBLOX_CLIENT_SECRET=
ROBLOX_REDIRECT_URI=

# --- Filesystem -----------------------------------------------------------
# Where per-build workspaces are written. Server-generated ids only.
WORKSPACE_ROOT=./.workspaces

# Honour X-Forwarded-* headers. true only behind a known reverse proxy.
TRUST_PROXY=false
